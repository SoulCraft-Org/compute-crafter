[
  {
    "id": "docs.dead_paths",
    "params": {
      "skip_dirs": [
        "node_modules",
        "worktrees",
        "vendor",
        "dist",
        "build",
        "coverage",
        ".venv",
        ".astro",
        ".wrangler",
        ".code-os-packs"
      ],
      "lint": {
        "interpreter": "python3",
        "script": "tools/voice_lint.py",
        "args": [
          "--rules",
          "tools/voice_rules.json"
        ],
        "scope": "every doc of the doc set"
      },
      "areas": [
        {
          "doc": "docs/handoff/**",
          "area": []
        },
        {
          "doc": ".claude/skills/**",
          "area": []
        },
        {
          "doc": "**",
          "area": [
            "{dir}/"
          ]
        }
      ]
    }
  }
]
