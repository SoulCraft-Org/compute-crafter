[
  {
    "id": "docs.dead_paths",
    "params": {
      "lint": {
        "interpreter": "python3",
        "script": "tools/voice_lint.py",
        "args": [
          "--rules",
          "tools/voice_rules.json"
        ],
        "scope": "every doc of the doc set"
      },
      "areas": [
        {
          "doc": "docs/handoff/**",
          "area": []
        },
        {
          "doc": ".claude/skills/**",
          "area": []
        },
        {
          "doc": "**",
          "area": [
            "{dir}/"
          ]
        }
      ]
    }
  }
]
