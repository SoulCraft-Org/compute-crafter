[
  {
    "id": "issues.open_bugs",
    "params": {
      "comment": "security.claude_review_share counts only merged PRs that change a file claude-review.yml reviews; keep this list equal to its on.pull_request.paths (git-crafter #838: reviews run on sensitive paths only, to save subscription tokens).",
      "review_paths": [
        "**/*.mjs",
        "**/*.js",
        "**/*.ts",
        "**/*.py",
        "**/*.sh",
        "tools/**",
        "actions/**",
        ".github/workflows/**",
        ".claude/settings.json",
        "manifest.json",
        "package.json",
        "package-lock.json"
      ]
    }
  },
  {
    "id": "issues.area_labeled",
    "params": {
      "comment": "The area labels every issue names (Compute Crafter's labels, 2026-11-24): guides, catalog, ci, quality, site, sign-ins.",
      "area_labels": [
        "area: guides",
        "area: catalog",
        "area: ci",
        "area: quality",
        "area: site",
        "area: sign-ins"
      ]
    }
  },
  {
    "id": "security.threat_model_current",
    "params": {
      "threat_model": "THREAT-MODEL.md",
      "threat_model_covers": [
        "collectors",
        "catalog",
        "tests/privacy.mjs",
        "tools",
        ".github/workflows"
      ],
      "threat_model_grace_days": 7
    }
  }
]
